# Copia este archivo como .env y rellena tus valores. NUNCA subas .env al repo.

# NIT que DIAN usa como contrasena de tus documentos (sin puntos ni guion).
# Es OBLIGATORIO. Es la contrasena que quita el cifrado del PDF/ZIP.
DIAN_NIT=

# Archivo de entrada con la columna CUFE (acepta .xlsx o .csv).
INPUT_FILE=facturas.csv

# Carpeta donde se guardan los PDF finales, logs y estado.
DOWNLOAD_DIR=descargas

# Carpeta del perfil persistente del navegador (mantiene sesion/cookies -> menos captchas).
BROWSER_PROFILE_DIR=.browser-profile

# El captcha exige navegador visible. Dejar en false.
HEADLESS=false

# Imprimir automaticamente el PDF al terminar cada descarga.
AUTO_PRINT=false
# Nombre exacto de la impresora (opcional; requiere SumatraPDF en Windows para elegirla).
PRINTER_NAME=

# URL base de busqueda (opcional). Si tu portal publico usa otro subdominio,
# cambialo aqui sin tocar el codigo. El CUFE se agrega al final.
# DIAN_SEARCH_URL=https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=

# Certificado digital DIAN (.pfx/.p12) SOLO si el portal exige certificado de
# cliente (error "Client Certificate Required"). Ruta local + su contrasena.
# CLIENT_CERT_PATH=C:\Users\Admin\certificado.pfx
# CLIENT_CERT_PASS=

# Segundos de pausa entre documentos (ritmo respetuoso con DIAN).
PACING_SECONDS=3
# Segundos maximos que la herramienta espera a que resuelvas el captcha y descargue.
CAPTCHA_TIMEOUT=300
# Timeout de navegacion en milisegundos.
NAV_TIMEOUT_MS=45000
